# Port the Vike dev / production server listens on.
PORT=3011

# Base URL of the Rift API server (server-side data fetching).
RIFT_API_URL=http://localhost:3100

# Comma-separated list of allowed CORS origins.
# Supports `*` as a wildcard, e.g. http://localhost:* or http://*.example.local
CORS_ORIGINS=http://localhost:*
