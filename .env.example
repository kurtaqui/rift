# MFE fragment server URLs (used by the shell for SSR fragment composition).
# Each MFE runs its own Hono/Vike server that exposes GET /fragment?url=<path>.
MFE_CHAMPIONS_URL=http://localhost:3011
MFE_TIER_LIST_URL=http://localhost:3012

# Set to "local" to skip fragment fetching and let MfeSlot render client-only.
# Useful when developing the shell without starting the MFE servers.
# MFE_SSR_MODE=local

# API server URL (apps/api)
RIFT_API_URL=http://localhost:3100

# Shell server port
PORT=3000
