# MFE fragment server URLs (used by the shell for SSR fragment composition).
# Each MFE runs its own Hono/Vike server that exposes GET /fragment?url=<path>.
MFE_CHAMPIONS_URL=http://localhost:3011
MFE_TIER_LIST_URL=http://localhost:3012

# Set to "local" to skip fragment fetching and let MfeSlot render client-only.
# Useful when developing the shell without starting the MFE servers.
# MFE_SSR_MODE=local

# Set to any non-empty value to enable isolated MFE dev mode: the shell's
# MfeSlot will load client-side JS via Module Federation (loadRemote) instead
# of the Vite alias. mfe-tier-list requires build-watch (see below).
# VITE_MFE_ISOLATED=true

# Override the client-side URL used for each MFE's MF manifest + JS chunks.
# Defaults to the fragment server URL (MFE_CHAMPIONS_URL / MFE_TIER_LIST_URL).
# In build-watch mode for mfe-tier-list, the shell serves its own built dist:
# MFE_TIER_LIST_CLIENT_URL=http://localhost:3000/static-assets/mfes/mfe-tier-list
# MFE_CHAMPIONS_CLIENT_URL=http://localhost:3000/static-assets/mfes/mfe-champions

# API server URL (apps/api)
RIFT_API_URL=http://localhost:3100

# Shell server port
PORT=3000
