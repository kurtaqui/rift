# MFE remote URLs — used by:
#   1. fetchMfeFragment (server-side) to reach each MFE's /fragment endpoint.
#   2. The Module Federation host plugin (vite build) for the mf-manifest.json entry.
#
# Dev defaults: leave unset so fetchMfeFragment falls back to http://localhost:3011
# and http://localhost:3012 (the MFE dev servers).
#
# Production / preview: set to the deployed MFE service URL or CDN path.
#   e.g. MFE_CHAMPIONS_URL=https://cdn.example.com/mfes/mfe-champions
#   e.g. MFE_CHAMPIONS_URL=/static-assets/mfes/mfe-champions  (preview: MFE dist served by shell)
#
MFE_CHAMPIONS_URL=http://localhost:3011
MFE_TIER_LIST_URL=http://localhost:3012

# API base URL for the dev proxy target.
RIFT_API_URL=http://localhost:3100

# Filesystem paths to each MFE's built dist/ (relative to apps/shell/).
# Used by the Hono static asset handler in preview/production.
MFE_CHAMPIONS_DIST=../../mfe/mfe-champions/dist
MFE_TIER_LIST_DIST=../../mfe/mfe-tier-list/dist
